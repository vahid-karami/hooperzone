# Copy to .env and fill in. Never commit .env.
SECRET_KEY=''
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: comma-separated origins, e.g. https://hooperzone.ir,https://www.hooperzone.ir
