# Copy to .env and fill in. Never commit .env.
SECRET_KEY=''
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173
# Production only: comma-separated origins, e.g. https://hooperzone.ir,https://www.hooperzone.ir
CSRF_TRUSTED_ORIGINS=
SECURE_COOKIES=True
# Set to e.g. 31536000 once Cloudflare SSL mode is "Full" (production only).
SECURE_HSTS_SECONDS=0

# Dev only: show OTP codes in API responses (production always hides them).
OTP_RETURN_IN_RESPONSE=True
OTP_THROTTLE_RATE=10/min
AUTH_THROTTLE_RATE=10/min

# ZarinPal. While PAYMENT_SANDBOX=True payments go to sandbox.zarinpal.com (no real money).
PAYMENT_SANDBOX=True
ZARINPAL_MERCHANT_ID=
IDPAY_API_KEY=

# SMS.ir verify template for OTP codes; the template needs a parameter named CODE.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=

# Wispbyte: fill once to create the admin user, then remove ADMIN_PASSWORD.
ADMIN_PHONE=
ADMIN_PASSWORD=
